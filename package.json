{
  "name": "anyvis",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:offline": "node scripts/check-scheduling.mjs && node scripts/test-block-program.mjs && node scripts/check-extensions.mjs",
    "check:syntax": "node scripts/check-syntax.cjs",
    "studio": "node scripts/start-studio.mjs",
    "start": "node scripts/start-studio.mjs --production",
    "desktop": "node scripts/start-studio.mjs --production --desktop",
    "test:server": "node --test server/server.test.mjs",
    "test:render": "node --test server/render.integration.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "@react-three/fiber": "^9.4.0",
    "@react-three/drei": "^10.7.0",
    "@xyflow/react": "^12.9.0",
    "blockly": "^12.3.1",
    "lucide-react": "^0.468.0",
    "mathjs": "^14.8.0",
    "@uiw/react-codemirror": "^4.25.0",
    "@codemirror/lang-javascript": "^6.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}

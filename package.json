{
  "name": "anyvis",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:offline": "node scripts/check-scheduling.mjs && node scripts/test-block-program.mjs && node scripts/check-extensions.mjs",
    "check:syntax": "node scripts/check-syntax.cjs",
    "studio": "node scripts/start-studio.mjs",
    "start": "node scripts/start-studio.mjs --production",
    "desktop": "npm run desktop:prepare && node scripts/launch-desktop.mjs",
    "test:server": "node --test server/server.test.mjs",
    "test:render": "node --test server/render.integration.mjs",
    "desktop:install": "npm install --prefix desktop",
    "desktop:prepare": "npm run build && node scripts/prepare-desktop.mjs",
    "desktop:pack": "npm run desktop:prepare && node desktop/node_modules/electron-builder/cli.js --config desktop/builder.config.cjs --publish never",
    "test:desktop": "node --test desktop/host.spec-node.mjs desktop/packaging.spec-node.mjs",
    "test:api-native": "node --test src/studio/core/api.native.spec-node.mjs src/studio/core/api-families.native.spec-node.mjs src/studio/core/api-queries.native.spec-node.mjs",
    "api:generate": "python scripts/generate-api-registry.py",
    "api:verify": "python scripts/verify-api-registry.py"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.4",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.4.0",
    "@uiw/react-codemirror": "^4.25.0",
    "@xyflow/react": "^12.9.0",
    "blockly": "^12.3.1",
    "lucide-react": "^0.468.0",
    "mathjs": "^15.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "0.28.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
